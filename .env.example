# ==============================================================================
# OpenViralClip Environment Variables
# Copy this file to .env and fill in your free-tier API keys.
# NEVER commit .env, client_secret.json, or token.json to version control.
# ==============================================================================

# Google AI Studio Free Tier (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq Free API for ultra-fast Whisper transcription (https://console.groq.com/keys)
# Optional if running faster-whisper locally or on Google Colab T4 GPU
GROQ_API_KEY=your_groq_api_key_here

# Local Ollama fallback (optional, no key required)
OLLAMA_BASE_URL=http://localhost:11434

# YouTube Data API v3 OAuth Credentials (Google Cloud Console - Free)
YOUTUBE_CLIENT_SECRET_PATH=client_secret.json
YOUTUBE_TOKEN_PATH=token.json

# Workspace & Output Directories
OVC_WORK_DIR=workspace
OVC_LOG_LEVEL=INFO
